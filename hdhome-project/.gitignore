# ===========================================
# Environment files (NEVER commit these!)
# ===========================================
.env
.env.local
.env.*.local
*.env
.env.import
.env.import.*

# ===========================================
# Dependencies
# ===========================================
node_modules/
.pnpm-store/

# ===========================================
# Build outputs
# ===========================================
dist/
build/
out/

# ===========================================
# IDE & Editor
# ===========================================
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

.vscode/
*.code-workspace
.settings/

# ===========================================
# OS files
# ===========================================
.DS_Store
Thumbs.db
Desktop.ini

# ===========================================
# Logs
# ===========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ===========================================
# Test coverage
# ===========================================
coverage/
.nyc_output/

# ===========================================
# Cache
# ===========================================
.cache/
.parcel-cache/
*.tsbuildinfo
*.tsbuildinfo

# ===========================================
# Backend specific
# ===========================================
backend/uploads/projects/*
!backend/uploads/projects/.gitkeep
*.sql
*.dump
!backend/database/schema.sql
!backend/database/seed.sql
!backend/database/seed-extra.sql
!backend/database/seed-projects-extra.sql

# ===========================================
# MariaDB/MySQL local database
# ===========================================
.mariadb/
*.db
*.sqlite
*.sqlite3

# ===========================================
# Temporary files
# ===========================================
tmp/
temp/
*.tmp
*.temp

# ===========================================
# Secrets (add any other secret file patterns here)
# ===========================================
*.pem
*.key
credentials.json
secrets.json

# ===========================================
# Error logs (auto-generated by .err files)
# ===========================================
*.err
backend/*.err
frontend/*.err
server.err
frontend.err

# ===========================================
# AWS scripts excluded from push (security)
# ===========================================
.excluded-aws-scripts/

# Log test local
backend/logs-test.out
