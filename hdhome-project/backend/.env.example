PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hdhome_management
DB_CONNECTION_LIMIT=10

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Gioi han dang nhap (mac dinh: 10 lan / 15 phut)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ===== Logging =====
LOG_LEVEL=info

# ===== Cache trong bo nho =====
CACHE_TTL_MS=60000
CACHE_MAX_ENTRIES=500

# ===== SMTP (bo trong neu khong gui email) =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="HDHOME" <your-email@gmail.com>
# ADMIN_EMAIL=admin@hdhome.vn
# REPORT_EMAIL=admin@hdhome.vn
